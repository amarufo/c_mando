# Copiar a `.env` (no se sube a Git). En Railway estas variables se definen en el panel del servicio.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=cambia-esto-en-produccion
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-app.up.railway.app

# En local no hace falta DATABASE_URL: se usa el PostgreSQL embebido de scripts/pg_local.py.
# En Railway se inyecta automáticamente al añadir el plugin PostgreSQL.
# DATABASE_URL=postgresql://usuario:clave@host:5432/base
